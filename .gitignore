__pycache__/
*.pyc
*.pyo
.env
.venv/
venv/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
node_modules/
package-lock.json
app/static/css/*.css
app/static/js/*.js
terraform/providers-mirror/
.playwright-mcp/
celerybeat-schedule
# Ansible collections installed/vendored into the path (keep the dir, not its contents)
ansible/collections/*
!ansible/collections/.gitkeep

# Locust run output (loadtest/README.md's --csv results) — generated per run, not checked in
loadtest/results/*
!loadtest/results/.gitkeep
